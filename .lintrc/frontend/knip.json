{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  "entry": ["src/index.ts"],

  "project": ["src/**/*.ts"],

  "ignore": [],

  "ignoreDependencies": [
    "@hey-api/client-fetch",
    "@commitlint/types",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser"
  ],

  "ignoreBinaries": ["commitlint", "cspell", "eslint", "prettier"],

  "ignoreUnresolved": [
    "eslint",
    "eslint-plugin-import",
    "eslint-plugin-unicorn",
    "eslint-plugin-sonarjs",
    "eslint-plugin-security",
    "eslint-plugin-promise",
    "eslint-plugin-n",
    "eslint-plugin-jsdoc",
    "eslint-import-resolver-typescript"
  ],

  "includeEntryExports": false,

  "exclude": [],

  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "nsExports": "error",
    "types": "error",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error"
  }
}
